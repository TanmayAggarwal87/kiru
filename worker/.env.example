# Kiru Worker Environment Variables Example
# Copy to .env and adjust values for local development.

# Backend API
KIRU_API_BASE_URL=http://localhost:4000
KIRU_WORKER_TOKEN=fake-worker-token-change-me

# Worker identity and runtime
WORKER_ID=local-worker-1
WORKER_EXECUTOR=local
WORKER_STAGES=probe,prepare_media,transcribe,analyze_signals,segment,score,reframe,captions,render
WORK_DIR=/tmp/kiru-worker
MAX_CONCURRENCY=1
LOG_LEVEL=INFO
SOURCE_CACHE_MAX_GB=10.0

# Speech-to-text (faster-whisper)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL_REVISION=main

# LLM endpoint (Ollama local / vLLM Modal)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b
LLM_API_KEY=

# Face detection (MediaPipe Tasks)
FACE_MODEL_PATH=assets/models/blaze_face_short_range.tflite
