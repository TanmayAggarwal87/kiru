  "info": {
    "title": "Kiru API",
    "description": "Kiru automated video clip generation API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "jwt": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "worker-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateProjectDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Title of the project",
            "example": "Podcast Episode 42"
          }
        },
        "required": [
          "title"
        ]
      }
    }
  }
