# ------------------------------------------------------------------------------
# Kiru Backend Environment Variables (.env.example)
# Copy this file to .env for development. Never commit real credentials!
# ------------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# CORS: Comma-separated list of allowed origins (e.g. Next.js frontend)
CORS_ORIGINS=http://localhost:3000

# Database (Supabase Postgres)
# Replace [PROJECT_REF], [REGION], and [PASSWORD] with your hosted Supabase credentials:
# - DATABASE_URL uses Supabase transaction pooler (port 6543)
# - DIRECT_URL uses direct/session connection (port 5432) for migrations
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase API URL and Keys
# - SUPABASE_URL: Project URL (e.g. https://[PROJECT_REF].supabase.co)
# - SUPABASE_PUBLISHABLE_KEY: Client/Anon publishable key
# - SUPABASE_SECRET_KEY: Server/Service role secret key
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_[YOUR_KEY]
SUPABASE_SECRET_KEY=sb_secret_[YOUR_KEY]

# Storage (Cloudflare R2 - S3 compatible)
R2_ACCOUNT_ID=mock_r2_account_id
R2_ACCESS_KEY_ID=mock_r2_access_key_id
R2_SECRET_ACCESS_KEY=mock_r2_secret_access_key
R2_BUCKET=kiru-dev

# Worker authentication: comma-separated SHA-256 hex hashes of authorized worker tokens
# Generate with: echo -n "<raw_token>" | sha256sum
WORKER_TOKEN_HASHES=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855

# Media & Upload Limits
MAX_UPLOAD_BYTES=2147483648
MAX_VIDEO_SECONDS=3600

# Presigned URL TTLs (seconds)
PRESIGN_PUT_TTL_SECONDS=3600
PRESIGN_GET_TTL_SECONDS=3600
DOWNLOAD_TTL_SECONDS=900

# Retention policies (days)
RETENTION_SOURCE_DAYS=3
RETENTION_INTERMEDIATE_DAYS=1
RETENTION_CLIP_DAYS=30

# User Quotas
PLAN_FREE_MINUTES_PER_MONTH=120

# Rate Limiting / Throttler (global)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
